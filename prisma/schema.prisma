generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Grupo {
  id              String     @id @default(cuid())
  nombre          String     @unique
  color           String     @default("#10B981")
  visibilidad     String     @default("PUBLIC") // "PUBLIC" or "PRIVATE"
  rolesPermitidos String[]   // e.g. ["ADMIN", "OBRAS"]
  capas           Capa[]
  subGrupos       SubGrupo[]
}

model SubGrupo {
  id        String   @id @default(cuid())
  nombre    String
  color     String   @default("#10B981")
  grupoId   String
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  capas     Capa[]
}

model Capa {
  id              String    @id @default(cuid())
  nombre          String
  tipo            String    // "geojson", "kml", "maphub"
  color           String    @default("#10B981")
  icono           String?   // Para guardar el nombre del icono de Lucide (ej: "MapPin")
  datosGeo        String    // Guardando JSON string de los datos GeoJSON
  visibilidad     String    @default("PUBLIC") // "PUBLIC" or "PRIVATE"
  rolesPermitidos String[]  // e.g. ["ADMIN", "VECINO"]
  grupoId         String?
  grupo           Grupo?    @relation(fields: [grupoId], references: [id])
  subGrupoId      String?
  subGrupo        SubGrupo? @relation(fields: [subGrupoId], references: [id], onDelete: SetNull)
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt
}

model Usuario {
  id          String        @id @default(cuid())
  firebaseUid String        @unique
  email       String        @unique
  nombre      String?
  rol         String        @default("PENDIENTE") // "SUPER_ADMIN", "ADMINISTRADOR", "USUARIO", "PENDIENTE"
  creadoEn    DateTime      @default(now())
  chatsSoporte ChatSoporte[]
}

model LineaTransporte {
  id            String   @id @default(cuid())
  nombre        String
  numero        String?
  color         String   @default("#E53E3E")
  descripcion   String?
  categoria     String   @default("NACIONAL")   // NACIONAL | PROVINCIAL | MUNICIPAL
  subcategoria  String?                          // ramal, e.g. "Ramal A"
  sentido       String?                          // IDA | VUELTA | null
  activo        Boolean  @default(true)
  datosGeo      String
  // Frecuencias y tiempo de demora (relevamiento con inspector humano)
  frecuenciaCalculada Float?   // Frecuencia calculada por inspector (viajes/hora)
  frecuenciaEsperada  Float?   // Frecuencia programada/teórica (viajes/hora)
  tiempoDemoraPromedio Float?  // Promedio de retrasos en minutos
  ultimaInspeccion  DateTime? // Última vez que un inspector revisó/actualizó
  inspectorId       String?   // ID del inspector que realizó la última revisión
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model SolicitudDispositivo {
  id                String    @id @default(cuid())
  nombre            String
  email             String
  deviceFingerprint String?
  deviceInfo        String?
  ipAddress         String?
  estado            String    @default("PENDIENTE")
  customToken       String?
  creadoEn          DateTime  @default(now())
  revisadoEn        DateTime?
}

model DispositivoBloqueado {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  motivo      String?
  email       String?
  creadoEn    DateTime @default(now())
}

model SesionQR {
  id                String    @id @default(cuid())
  estado            String    @default("PENDIENTE") // PENDIENTE | ESCANEADO | APROBADO | RECHAZADO
  nombre            String?
  email             String?
  deviceFingerprint String?
  deviceInfo        String?
  ipCelular         String?
  customToken       String?
  creadoEn          DateTime  @default(now())
  expiraEn          DateTime
  revisadoEn        DateTime?
}

model RutaTransporte {
  id                String   @id @default(cuid())
  // Identificación de la solicitud
  numeroSolicitud   String?
  idSolicitudWeb    String?
  enlaceDocumento   String?
  fechaCreacion     String?
  // Solicitante
  nombreSolicitante String
  empresaSolicitante String?
  cuilCuit          String?
  emailSolicitante  String?
  telefonoSolicitante String?
  // Vehículo
  patente           String?
  tipoVehiculo      String?
  pesoToneladas     Float?
  cargaPeligrosa    Boolean  @default(false)
  tipoCarga         String?
  largoVehiculo     String?
  anchoVehiculo     String?
  alturaVehiculo    String?
  cantidadEjes      Int?
  aseguradora       String?
  nroSeguro         String?
  // Recorrido
  calles            String?
  origenDireccion   String?
  origenLocalidad   String?
  origenPartido     String?
  origenNombre      String?
  destinoDireccion  String?
  destinoLocalidad  String?
  destinoPartido    String?
  destinoNombre     String?
  frecuencia        String?
  horario           String?
  observaciones     String?
  // Vigencia y estado
  vigenciaDesde     String?
  vigenciaHasta     String?
  estado            String   @default("PENDIENTE")
  tipoServicio      String   @default("FIJO") // FIJO o A_DEMANDA
  // Tracking y Auditoría
  creadoPorId       String?
  creadoPorNombre   String?
  editadoPorId      String?
  editadoPorNombre  String?
  activo            Boolean  @default(true)
  // GeoJSON
  datosGeo          String
  creadoEn          DateTime @default(now())
}

model RolPermisos {
  id                String   @id @default(cuid())
  rol               String   @unique
  accesoAdmin       Boolean  @default(false)
  verCapas          Boolean  @default(false)
  editarCapas       Boolean  @default(false)
  verLineas         Boolean  @default(false)
  editarLineas      Boolean  @default(false)
  verRutas          Boolean  @default(false)
  editarRutas       Boolean  @default(false)
  verReclamos       Boolean  @default(false)
  editarReclamos     Boolean  @default(false)
  gestionarGrupos   Boolean  @default(false)
  gestionarUsuarios Boolean  @default(false)
}

model Reclamo {
  id            String   @id // ID del reclamo (ej: "1006")
  numero        String   @unique // Código del expediente (ej: "2026-1006")
  titulo        String
  descripcion   String?
  estado        String   // nuevo | asignado | resuelto | etc.
  prioridad     String   // baja | media | alta | urgente
  lat           Float
  lng           Float
  direccion     String?
  ciudadano     String?
  dniCiudadano  String?
  fecha         String?  // Fecha del reclamo en formato SAT
  motivoId      Int
  motivoNombre  String
  canalEntrada  String?  // Web | WhatsApp | etc.
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([motivoId])
  @@index([estado])
}

model ChatSoporte {
  id            String           @id @default(cuid())
  usuarioId     String
  usuario       Usuario          @relation(fields: [usuarioId], references: [firebaseUid], onDelete: Cascade)
  resuelto      Boolean          @default(false)
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt
  mensajes      MensajeSoporte[]

  @@index([usuarioId])
}

model MensajeSoporte {
  id              String      @id @default(cuid())
  chatId          String
  chat            ChatSoporte @relation(fields: [chatId], references: [id], onDelete: Cascade)
  remitenteId     String
  remitenteNombre String
  remitenteRol    String
  texto           String
  imagen          String?     @db.Text
  creadoEn        DateTime    @default(now())

  @@index([chatId])
}

model EnlaceCompartido {
  id              String    @id @default(cuid())
  token           String    @unique
  titulo          String    @default("Vista Personalizada GIS")
  descripcion     String?
  capasPermitidas String[]  // Array de IDs de capas/líneas/rutas permitidas
  permitirReclamos Boolean  @default(false)
  creadoPor       String?
  expiraEn        DateTime?
  creadoEn        DateTime  @default(now())
}

model RelevamientoGPS {
  id               String    @id @default(cuid())
  uuid             String?   // UUID original de BusTrackerGPS
  lineaNumero      String?   // Ej: "523", "158"
  ramal            String?   // Ej: "Ramal A"
  sentido          String?   // "IDA" | "VUELTA"
  interno          String?   // Número de interno del colectivo
  patente          String?   // Patente / Dominio
  chofer           String?   // Conductor o inspector
  notas            String?
  estado           String    @default("FINALIZADO") // "ACTIVO" | "PAUSADO" | "FINALIZADO"

  fechaInicio      DateTime?
  fechaFin         DateTime?
  duracionMs       Int       @default(0)
  distanciaMeters  Float     @default(0)
  movingTimeMs     Int       @default(0)
  stoppedTimeMs    Int       @default(0)
  velocidadProm    Float     @default(0)
  velocidadMax     Float     @default(0)

  puntosCount      Int       @default(0)
  paradasCount     Int       @default(0)
  incidenciasCount Int       @default(0)

  datosGeo         String    @db.Text // GeoJSON FeatureCollection (LineString, Stops, Incidents)

  origen           String    @default("APP_MOBILE") // "APP_MOBILE" | "IMPORTACION_GEOJSON" | "IMPORTACION_GPX" | "IMPORTACION_ZIP"
  dispositivo      String?
  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt

  @@index([lineaNumero])
  @@index([sentido])
  @@index([creadoEn])
}

model IntervencionVial {
  id               String             @id @default(cuid())
  codigo           String             @unique // Ej: "CORTE-2026-0042"
  titulo           String             // Ej: "Bacheo y repavimentación Av. 25 de Mayo"
  tipo             String             // BACHEO | EVENTO | MANTENIMIENTO | AGUA_GAS | SINIESTRO | OTRO
  tipoCorte        String             @default("TOTAL") // TOTAL | PARCIAL | REDUCCION_CALZADA
  motivo           String?
  areaResponsable  String?            // Obras Públicas, Tránsito, Espacio Público, etc.
  callesAfectadas  String?            // "Av. 25 de Mayo e/ San Martín y Del Valle Iberlucea"
  
  fechaInicio      DateTime
  fechaFinEstimada DateTime?
  fechaFinReal     DateTime?
  estado           String             @default("PLANIFICADO") // PLANIFICADO | EN_CURSO | FINALIZADO | CANCELADO
  
  // Geometría del corte (Point, LineString o Polygon en formato GeoJSON string)
  datosGeo         String             @db.Text
  
  // Desvíos asociados a las líneas de transporte público
  desvios          DesvioTransporte[]
  
  creadoPorId      String?
  creadoPorNombre  String?
  creadoEn         DateTime           @default(now())
  actualizadoEn    DateTime           @updatedAt

  @@index([estado])
  @@index([fechaInicio])
}

model DesvioTransporte {
  id                 String           @id @default(cuid())
  intervencionId     String
  intervencion       IntervencionVial @relation(fields: [intervencionId], references: [id], onDelete: Cascade)
  
  lineaId            String?          // Referencia a LineaTransporte
  lineaNumero        String           // "520", "158", "9", etc.
  ramal              String?          // "Ramal B", "Por Obon", etc.
  sentido            String?          // IDA | VUELTA | AMBOS
  
  // Trazado del desvío alternativo (GeoJSON LineString o MultiPoint)
  datosGeoDesvio     String           @db.Text
  
  // Indicaciones para inspectores, choferes y vecinos
  callesDesvio       String?          @db.Text // "Desvía por Ministro Brin -> Carlos Tejedor -> retoma..."
  paradasAnuladas    String?          @db.Text
  paradasProvisorias String?          @db.Text
  
  activo             Boolean          @default(true)
  creadoEn           DateTime         @default(now())
  actualizadoEn      DateTime         @updatedAt

  @@index([intervencionId])
  @@index([lineaNumero])
}
